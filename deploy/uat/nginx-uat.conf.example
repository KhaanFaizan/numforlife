# UAT nginx example — two Next.js processes

upstream numforlife_web {
    server 127.0.0.1:3000;
    keepalive 32;
}

upstream numforlife_admin {
    server 127.0.0.1:3001;
    keepalive 32;
}

server {
    listen 443 ssl http2;
    server_name uat.numforlife.com;

    ssl_certificate     /etc/letsencrypt/live/uat.numforlife.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/uat.numforlife.com/privkey.pem;

    location /media/ {
        alias /var/www/numforlife-shared/media/;
        access_log off;
    }

    location / {
        proxy_pass http://numforlife_web;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }

    location /api/health {
        proxy_pass http://numforlife_web;
        access_log off;
    }
}

server {
    listen 443 ssl http2;
    server_name uat-admin.numforlife.com;

    ssl_certificate     /etc/letsencrypt/live/uat-admin.numforlife.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/uat-admin.numforlife.com/privkey.pem;

    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://numforlife_admin;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
    }
}

server {
    listen 80;
    server_name uat.numforlife.com uat-admin.numforlife.com;
    return 301 https://$host$request_uri;
}
