  "dynamicRoutes": [
    {
      "page": "/celue/[slug]",
      "regex": "^/celue/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/celue/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/celue/[slug]/result",
      "regex": "^/celue/([^/]+?)/result(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/celue/(?<nxtPslug>[^/]+?)/result(?:/)?$"
    },
    {
      "page": "/shop/[id]",
      "regex": "^/shop/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/shop/(?<nxtPid>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
