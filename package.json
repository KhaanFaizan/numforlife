{
  "name": "numforlife-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "admin",
    "packages/shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @numforlife/frontend",
    "dev:admin": "npm run dev -w @numforlife/admin",
    "dev": "npm run dev:frontend",
    "build": "npm run build -w @numforlife/frontend && npm run build -w @numforlife/admin",
    "build:frontend": "npm run build -w @numforlife/frontend",
    "build:admin": "npm run build -w @numforlife/admin",
    "lint": "npm run lint -w @numforlife/frontend && npm run lint -w @numforlife/admin"
  }
}
