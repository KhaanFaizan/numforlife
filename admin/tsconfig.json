{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/lib/*": ["../packages/shared/lib/*"],
      "@/components/ui/*": ["../packages/shared/components/ui/*"],
      "@/components/home/*": ["../frontend/components/home/*"],
      "@/components/sections/*": ["../frontend/components/sections/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
